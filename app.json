{
  "expo": {
    "name": "expo-location-geofencing-repro",
    "slug": "expo-location-geofencing-repro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.repro.expolocationgeofencing"
    },
    "android": {
      "package": "dev.repro.expolocationgeofencing",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to demonstrate geofencing.",
          "locationAlwaysAndWhenInUsePermission": "Used to demonstrate geofencing.",
          "locationAlwaysPermission": "Used to demonstrate geofencing."
        }
      ]
    ]
  }
}
